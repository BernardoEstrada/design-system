{
  "name": "@bernardoestrada/design-system",
  "version": "0.5.1",
  "description": "React + DaisyUI v5 component library and theme collection",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BernardoEstrada/design-system.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./icon-picker": {
      "types": "./dist/icon-picker.d.ts",
      "import": "./dist/icon-picker.js",
      "require": "./dist/icon-picker.cjs"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js",
      "require": "./dist/icons/index.cjs"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js",
      "require": "./dist/icons/*.cjs"
    },
    "./styles": {
      "types": "./types/styles.d.ts",
      "default": "./dist/index.css"
    }
  },
  "files": [
    "dist",
    "types"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "node scripts/gen-icons.mjs && tsc -b && vite build",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "icons:update": "node scripts/update-icons.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@lucide/lab": "^0.7.0",
    "lucide-react": "^1.63.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@storybook/addon-themes": "^10.4.1",
    "@storybook/react": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "daisyui": "^5.0.0",
    "eslint": "^9.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.4.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
